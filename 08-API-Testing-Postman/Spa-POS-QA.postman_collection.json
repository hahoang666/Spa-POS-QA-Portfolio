{
  "info": {
    "name": "Spa POS — Historical RPC QA (Sanitized Template)",
    "description": "Reconstructed from historical QA chats and repo. NOT an original Postman export; NOT re-executed. Mutating requests affect your database. Use dedicated disposable QA fixtures. Never commit secrets or tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Authentication",
      "description": "Login requires publishable/anon key and real credentials stored only locally.",
      "item": [
        {
          "name": "Login — password grant (template)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_API_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
              "host": [
                "{{SUPABASE_URL}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ADMIN_EMAIL}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Historical login returned 200. Do not export live credentials or tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test(\"Has access token\",()=>pm.expect(pm.response.json()).to.have.property(\"access_token\"));"
                ]
              }
            }
          ]
        }
      ]
    },
